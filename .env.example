# Copy this file to .env and fill in your real MySQL Workbench credentials.
# Never commit the real .env file to GitHub — add it to .gitignore.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=scholarship_portal

JWT_SECRET=replace_with_a_long_random_string

PORT=5000
